		(uuid "d4a04ddf-be76-56bc-ae36-0bf4ca2c2975")
	)
	(text_box "BENCH ITEMS on this sheet: RTC6705 pin 11 RF_VT2 open (V5 spur check); PA drive Re final value (V5 / V8, 27R fallback line); PA_VREF window and the HD switch-on excursion (V5 / V9, PA REFERENCE note); VIDEO_OUT OSD contrast and edges (V9, OSD sheet); X4 start-up margin (V5: series R 3-5x the 250R ESR, -10 C cold start, slow supply ramp); Q27, R73, R65 temperature at the top step (V5 / V8, PNP PA DRIVE note)."
		(exclude_from_sim no)
		(at 485.14 50.92 0)
