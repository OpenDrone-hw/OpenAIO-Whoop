		(uuid "c5df5b8d-aec0-5f2a-b47a-9f31da2999f5")
	)
	(text_box "SHEET SOURCE. Generated by gen_vtx.py (hardware/tools/sch_build.py + sch_root.py). No OpenDrone sibling sheet or commons block exists for an RTC6705 VTX, so the circuit follows the OpenOSD-X v1.01 reference schematic (RTC6705 supply pins, video network, loop filter, PAOUT1 feed), the Skyworks SE5004L datasheet 202393B + EK1 and DESIGN-SPEC 4.8. Refs, values, MPNs and footprints: hardware/bom_plan.json. Signal flow: ESP32 controls (RX sheet) on the left, RTC6705 in the middle, PA, BPF and U.FL on the right."
		(exclude_from_sim no)
		(at 485.14 34.29 0)
		(size 93.98 15.36)
		(margins 0.9525 0.9525 0.9525 0.9525)
