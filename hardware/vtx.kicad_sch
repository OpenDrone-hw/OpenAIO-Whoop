				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a5e93d82-e7fa-5aa0-925a-f594761d4565")
	)
	(text_box "PAOUT1 FEED + DC BLOCK (OpenOSD-X L4 C40 C43 R34, fed by the PNP stage instead of its NPN follower). PAOUT1 (pin 35, +2 dBm) -> L3 4.7 nH choke to PAOUT1_SUP (C109 10 nF X7R) <- R65 10R <- Q27_C; C110 10 pF DC block into RF_PA_IN (SE5004L pin 3 'DC block required'). Only L3, C109 and C110 sit in the 5.8 GHz part-free band between pin 35 and the PA (50 Ohm CPWG < 5 mm, 45 degree). RF class on RF_PAOUT1 / RF_PA_IN / RF_PA_OUT / RF_UFL (pattern */RF_*)."
		(exclude_from_sim no)
		(at 139.7 263.2 0)
		(size 160.02 9.18)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
