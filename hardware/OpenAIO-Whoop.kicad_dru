(version 1)

# OpenDrone canonical design rules.
#
# Copied from hardware-template into every board repo. Keep the block above the
# marker byte-identical across repos. Board-specific rules go
# below the marker, never in the middle.
#
# This file holds CUSTOM rules only. The fab numbers that gate a JLCPCB order
# live in the project file under board.design_settings.rules, and come from
# Board Setup > Import Settings from Another Board, pointed at
# kicad/templates/OpenDrone-6L. The line standard is:
#
#   clearance 0.09   track 0.09   via 0.35 / 0.20 drill
#   annular 0.075    hole-to-hole 0.20        edge clearance 0.20
#
# Do not restate those here. Two copies of a number drift, and the one you are
# not looking at is the one that is wrong.

(rule "silkscreen over pad"
  (constraint silk_clearance (min 0.15mm))
  (condition "A.Type == 'Pad'"))

# --- board-specific rules below this line ------------------------------------
#
# OpenAIO-Whoop board rules (research/DESIGN-SPEC.md 7, 8.1, 8.4, 10, 11; D6, D7, D21). Generated by
# hardware/tools/setup_board.py: change the script, not this file. Numbers that gate the fab live in the
# .kicad_pro (clearance 0.09, track 0.09, via 0.35 / 0.15, annular 0.09, through hole 0.15, hole to
# hole 0.20, hole clearance 0.18, copper to edge 0.20, silk text 0.8 / 0.13); the rules below are what this
# board needs on top of them, from the NextPCB published limits (HDI 1+4+1, nextpcb.com/pcb-capabilities,
# /advanced-pcb-capabilities, /pcb-product/hdi-6layers). D21: every deliberate break of a conservative rule
# is a rule named 'D21 <name>' with its reason; nothing is ignored globally.

# D122 (owner: "put all of the copper to copper stuff at a minimum"): one copper clearance, the NextPCB 0.09 minimum,
# for every net and item. Custom rules override net class clearances; the rules below it are the only exceptions
# (RF CPWG gap, plated-hole copper).
(rule "copper clearance 0.09 everywhere"
  (constraint clearance (min 0.09mm)))

# Spec 8.2: the 0.15 gap sets the 50 ohm CPWG impedance, so RF copper keeps it to every other net.
(rule "RF: CPWG gap 0.15"
  (constraint clearance (min 0.15mm))
  (condition "(A.NetClass == 'RF' || B.NetClass == 'RF') && A.Net != B.Net"))

# Owner decision D97 (HDI): NextPCB 1+4+1 (HDI I), laser microvias L1-L2 and L6-L5 in the 1080 build-up, mechanical
# buried vias L2-L5 in the core sub-lamination; no through vias. No mechanical blind vias (another press cycle).
(rule "HDI 1+4+1: no mechanical blind vias"
  (constraint disallow blind_via))

# D107 / D116: the board has no through vias; every via is a laser microvia in a pad or a buried L2-L5 via under
# a body. A through via (KiCad 'V') blocks all six layers and is an error here; use Place Microvia / Place Blind/Buried.
(rule "HDI 1+4+1: no through vias"
  (constraint disallow through_via))

# Laser vias span one 1080 layer only (NextPCB laser AR 1:1 max, 0.75:1 recommended); no skip vias.
(rule "HDI 1+4+1: microvias L1-L2 and L5-L6 only"
  (constraint disallow micro_via)
  (condition "!((A.Layer_Top == 'F.Cu' && A.Layer_Bottom == 'In1.Cu') || (A.Layer_Top == 'In4.Cu' && A.Layer_Bottom == 'B.Cu'))"))

# The buried via is drilled through the L2-L5 sub-lamination (about 0.74 mm), resin filled and capped (POFV).
(rule "HDI 1+4+1: buried vias L2-L5 only"
  (constraint disallow buried_via)
  (condition "!(A.Layer_Top == 'In1.Cu' && A.Layer_Bottom == 'In4.Cu')"))

# NextPCB laser 0.075-0.15; 0.10 gives AR 0.77:1 in 0.077 mm 1080 and copper-fills flat for via-in-pad.
(rule "HDI microvia: laser hole 0.10 to 0.125"
  (constraint hole_size (min 0.10mm) (max 0.125mm))
  (condition "A.Via_Type == 'Micro'"))

# NextPCB min pad 8 mil, laser registration +-2 mil: 0.25 land / 0.075 ring (0.30 where room).
(rule "HDI microvia: land 0.25, ring 0.075"
  (constraint via_diameter (min 0.25mm))
  (constraint annular_width (min 0.075mm))
  (condition "A.Via_Type == 'Micro'"))

# NextPCB min mechanical drill 0.15 (boards <= 1.2 mm); the netclass via size applies (0.35 / 0.40). 0.15 in the
# 0.77 mm L2-L5 stack is AR 5.2:1. The 0.20 drill stays legal for the 0.40 power via.
(rule "HDI buried via: mechanical hole 0.15 to 0.25"
  (constraint hole_size (min 0.15mm) (max 0.25mm))
  (condition "A.Via_Type == 'Buried'"))

# NextPCB 0.30 (12 mil) between holes of different nets. Same net stays at the 0.20 (8 mil) minimum.
(rule "hole to hole, different nets 0.30"
  (constraint hole_to_hole (min 0.30mm))
  (condition "A.Net != B.Net"))

# D21: the 0.30 CAF spacing above is for holes of different nets; via arrays of one net (phase fields, EP
# arrays, battery and power arrays) stay at the 0.20 board minimum (NextPCB: via to via, same net, 8 mil).
(rule "D21 same_net_via_array"
  (constraint hole_to_hole (min 0.20mm))
  (condition "A.Net == B.Net && A.Type == 'Via' && B.Type == 'Via'"))

# D21: a staggered microvia lands on the buried via's L2/L5 land, 0.25 mm centre to centre (0.10 mm hole to
# hole) so the laser hole sits on solid copper, not on the resin fill; both holes share only that copper layer.
# NextPCB EQ: its page gives 0.20 for same-net via to via and says nothing about a laser hole beside a buried
# hole; with the 0.15 buried drill the gap at 0.25 c-c is 0.125. A stacked microvia (0 mm) is the alternative.
(rule "D21 HDI staggered microvia on a buried via land"
  (constraint hole_to_hole (min 0.10mm))
  (condition "A.Net == B.Net && ((A.Via_Type == 'Micro' && B.Via_Type == 'Buried') || (A.Via_Type == 'Buried' && B.Via_Type == 'Micro'))"))

# NextPCB 0.30 hole to hole (12 mil, different nets) between plated pad holes (battery holes, motor wire
# anchors); the 0.40 copper rule below is the tighter one for most pairs.
(rule "PTH pad holes 0.30 apart"
  (constraint hole_to_hole (min 0.30mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.isPlated() && B.isPlated()"))

# NextPCB 0.40 copper between pads with holes, different nets. Footprint vias (Heatsink pads, D21 below) are
# vias, not component holes, and keep the via clearances.
(rule "PTH pads, copper 0.40 apart"
  (constraint clearance (min 0.40mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole' && A.Net != B.Net && A.Fabrication_Property != 'Heatsink pad' && B.Fabrication_Property != 'Heatsink pad'"))

# D65 / D21: the Molex 53047 PicoBlade header fixes the 1.25 mm pitch; 0.92 rings (0.50 drill + 0.21 ring)
# leave 0.33 mm copper between neighbouring holes (NextPCB 0.40 general value; the BetaFPV Matrix 1S 5IN1 II
# ships the same 1.25 mm plated land). Scoped to MotorPad_PicoBlade pads (the four lands are far apart); NextPCB EQ item.
(rule "D65 plug-ready motor land: PicoBlade rings 0.33 apart"
  (constraint clearance (min 0.30mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('*:MotorPad_PicoBlade*') && B.memberOfFootprint('*:MotorPad_PicoBlade*')"))

# Component holes: 0.20 ring (NextPCB research 2026-10-07; the 3.5 mil page value does not separate vias).
(rule "PTH annular ring 0.20"
  (constraint annular_width (min 0.20mm))
  (condition "A.Type == 'Pad' && A.isPlated()"))

# NextPCB 0.23 (9 mil) from a plated pad hole to a track. Via holes keep the 0.18 board minimum (7 mil).
(rule "PTH hole to copper 0.23"
  (constraint hole_clearance (min 0.23mm))
  (condition "A.Type == 'Pad' && A.isPlated()"))

# Inner layers, plated pad holes: NextPCB publishes no inner-layer value; 0.30 kept (EQ).
(rule "inner layers: PTH hole to copper 0.30"
  (layer inner)
  (constraint hole_clearance (min 0.30mm))
  (condition "A.Type == 'Pad' && A.isPlated()"))

# NextPCB 0.40 minimum non-plated hole. The mounting holes are Edge.Cuts cut-outs, not pads.
(rule "NPTH at least 0.40"
  (constraint hole_size (min 0.40mm))
  (condition "A.Type == 'Pad' && !A.isPlated()"))

# Silk clipped at the routed edge or a hole is lost (line silk rule, pcb-agent-commons). KiCad 10.0.6
# tests silk against Edge.Cuts with the silk_clearance constraint, not edge_clearance.
(rule "silk 0.20 from the edge and holes"
  (constraint silk_clearance (min 0.20mm))
  (condition "A.Layer == 'Edge.Cuts' && (B.Layer == 'F.Silkscreen' || B.Layer == 'B.Silkscreen')"))

# Spec 7 / 8.1: components 0.30 from the routed edge and the mounting holes (copper 0.20 is the fab limit).
# Edge solder pads (user, motor and battery pads) are the intended exception, scoped by footprint: they
# keep the 0.20 copper-to-edge minimum (D7: exceptions as named, scoped rules).
(rule "parts: pads 0.30 from the edge"
  (constraint edge_clearance (min 0.30mm))
  (condition "A.Type == 'Pad' && !(A.memberOfFootprint('*:small_pad*') || A.memberOfFootprint('*:SolderPad*') || A.memberOfFootprint('*:MotorPad*') || A.memberOfFootprint('*:BattPad*') || A.memberOfFootprint('*:motor_pad*') || A.memberOfFootprint('*:battery_pad*') || A.memberOfFootprint('*:BT2*'))"))

# Spec 7 part keepout band (rule area PART_EDGE_BAND, 0.30 mm inside the outline), tested on courtyards;
# solder-pad footprints (component class SOLDER_PAD) are exempt like above.
(rule "parts: courtyards off the edge band"
  (constraint disallow footprint)
  (condition "A.Type == 'Footprint' && A.intersectsArea('PART_EDGE_BAND') && !A.hasComponentClass('SOLDER_PAD')"))

# Spec 8.4 / D2 body rule: courtyards are drawn at max(body, land) + 0.10 (P3 normalises the library), so
# touching courtyards are 0.20 mm body to body. courtyards_overlap is a warning in the .kicad_pro (owner).
(rule "courtyards: touching allowed, overlap is an error"
  (constraint courtyard_clearance (min 0mm)))

# Spec 8.1 / 8.4: NextPCB asks 0.25 between two 0402 (0.20 for 0201).
(rule "0402 to 0402: +0.05"
  (constraint courtyard_clearance (min 0.05mm))
  (condition "A.hasComponentClass('PASSIVE_0402') && B.hasComponentClass('PASSIVE_0402')"))

# Spec 8.4: the U.FL and the 2520 inductor (and any SH1.0 part) shadow small passives for paste, AOI and
# rework. D69 (owner): a preference traded for density; the 0.2 mm body rule (check_spacing.py) remains.
(rule "tall parts: 0.5 to 0201 and 0402"
  (constraint courtyard_clearance (min 0mm))
  (condition "A.hasComponentClass('TALL') && (B.hasComponentClass('PASSIVE_0201') || B.hasComponentClass('PASSIVE_0402'))"))

# Spec 8.4: user, battery and motor pads take a 60-80 W iron; keep small passives 0.5 mm away.
# D69 / D70 (owner): the iron halo is the 0.2 mm body rule (check_spacing.py); courtyards may touch.
(rule "solder pads: 0.5 to 0201 and 0402"
  (constraint courtyard_clearance (min 0mm))
  (condition "A.hasComponentClass('SOLDER_PAD') && (B.hasComponentClass('PASSIVE_0201') || B.hasComponentClass('PASSIVE_0402'))"))

# D21 / spec 10 (iron rework 'from every part on its side'): a motor pad is soldered on the top; its far side
# is only the 0.9 mm anchor-hole ring, so the 0.5 mm small-passive halo applies on the pad's side, and the far
# side keeps the plain courtyard rule (no overlap). Battery pads are pads on both sides and keep the halo there.
(rule "D21 motor_pad_ring_side"
  (constraint courtyard_clearance (min 0mm))
  (condition "A.hasComponentClass('MOTOR_PAD') && A.Layer != B.Layer"))

# D67: TP1-TP9, TP12, TP13 are mask-open filled 0.35/0.20 vias drawn as footprints (TestPoint_Via_*); the via
# hole spacing (0.20, pro minimum) applies, not the 0.30 component-hole value.
(rule "D67 test vias are vias: hole spacing 0.20"
  (constraint hole_to_hole (min 0.20mm))
  (condition "A.memberOfFootprint('*:TestPoint_Via*') && B.memberOfFootprint('*:TestPoint_Via*')"))

# D65 / D21: the bottom-side courtyards of two neighbouring plug-ready motor lands (optional DNP PicoBlade
# header envelopes) meet at the ear corner; the header bodies keep the 0.2 mm body rule (check_spacing.py), so
# both headers can be fitted. Scoped to MOTOR_PAD pairs only.
(rule "D65 DNP motor headers: courtyards may meet at the ear corner"
  (severity ignore)
  (constraint courtyard_clearance (min 0mm))
  (condition "A.hasComponentClass('MOTOR_PAD') && B.hasComponentClass('MOTOR_PAD')"))

# D21 / spec 11: FET, battery, motor and user solder pads join their pours solid (no thermal relief): the
# power path and the iron need the copper; reflow is profiled for it (NextPCB EQ).
(rule "D21 fet_solid_pads"
  (constraint zone_connection solid)
  (condition "A.Type == 'Pad' && (A.hasComponentClass('POWER_FET') || A.hasComponentClass('SOLDER_PAD'))"))

# Spec 8 / 11 and D6: every via that sits in a pad is filled with non-conductive epoxy and capped
# (IPC-4761 type VII). The board setting fills and caps all vias (filling yes, capping yes), so no via
# is ever left open in a pad. KiCad 10.0.6 cannot test a via inside a same-net pad, so there is no rule
# for it; order the NextPCB via-in-pad option (spec 8.1) and keep the 0.35 / 0.20 via (0.40 / 0.20 in
# power arrays outside pads).

# Spec 4.8 / 4.9: footprints with NC pads removed (RTC6705) or the NOR exposed pad removed are saved as
# their own footprints in the project library (P3), so lib_footprint_mismatch stays an error and never
# fires for them; no rule is needed and none is relaxed.

# The TPS61022 output carries 2-3 A with a DJI O4 Lite on VHD (D114 removed the load switch); pours preferred.
# Warning severity so the necks into 0201 and QFN pads stay legal.
(rule "Boost output: +5V_BST and +5V at least 0.30 wide"
  (severity warning)
  (constraint track_width (min 0.30mm))
  (condition "A.NetName == '+5V_BST' || A.NetName == '+5V'"))

# D21 / spec 8.3: through vias drawn inside a footprint land as PTH pads with the Heatsink fabrication property
# (EFM8BB51 EP array) are 0.35/0.15 Type VII vias, not component holes: the via annular ring 0.09 (NextPCB
# 3.5 mil) applies instead of the 0.20 PTH component-hole ring (LIBRARY.md item).
(rule "D21 footprint_via_pads annular"
  (constraint annular_width (min 0.09mm))
  (condition "A.Type == 'Pad' && A.Fabrication_Property == 'Heatsink pad'"))

# D21: the same footprint vias keep the 0.18 via hole clearance, not the 0.23 / 0.30 component-hole values.
(rule "D21 footprint_via_pads hole_clearance"
  (constraint hole_clearance (min 0.18mm))
  (condition "A.Type == 'Pad' && A.Fabrication_Property == 'Heatsink pad'"))

# D21 / D39: same-net footprint vias keep the 0.20 hole spacing of a via array, not the 0.30 PTH pad value.
(rule "D21 footprint_via_pads same_net_holes"
  (constraint hole_to_hole (min 0.20mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Fabrication_Property == 'Heatsink pad' && B.Fabrication_Property == 'Heatsink pad' && A.Net == B.Net"))

# Spec 4.7 / 8.1, only if the NextPCB EQ (O15) accepts 0.35 mm pitch: one ganged mask opening per side of
# the ESP32-D0WD-V3 land, set as the footprint attribute 'allow soldermask bridges' on that footprint only
# (P3). Not active until then.

# Four routing layers: F, In1, In4 and B. In2 is the continuous ground reference.
# A ground zone supplies continuity; routed traces must not split this plane.
(rule "In2 solid GND: no tracks"
  (constraint disallow track)
  (condition "A.Layer == 'In2.Cu'"))

# In2 is the ground plane. In1/In4 use local ground pours around signal routes.
# Reserve unbroken In1/In4 ground under outer RF, USB and video routes.
(rule "In1 In2 In4: GND zones only"
  (constraint disallow zone)
  (condition "(A.Layer == 'In1.Cu' || A.Layer == 'In2.Cu' || A.Layer == 'In4.Cu') && A.NetName != 'GND'"))

# In3 distributes battery and regulated supply islands, with ground where needed for a local return.
# Signals and motor phases do not use this plane.
(rule "In3: supply and ground distribution only"
  (constraint disallow track zone)
  (condition "A.Layer == 'In3.Cu' && A.NetName != 'GND' && A.NetClass != 'VBAT' && A.NetClass != 'Power'"))

# In1/In4 carry signals. Phase power stays outer; four bounded .12 mm In1/In4 pickups carry divider current.
# VIDEO_IN has one bounded 1.273 mm In1 bridge over In2 GND. Kelvin, regulator feedback, oscillator and RF nets stay outer. ADC, OSD_LVL and PA_DET use bounded corridors.
(rule "Inner signal layers: no battery phase RF or sensitive analog"
  (constraint disallow track zone)
  (condition "((A.Layer == 'In1.Cu' || A.Layer == 'In4.Cu') && (A.NetClass == 'VBAT' || (A.NetClass == 'Phase' && !(A.Type == 'Track' && A.Width == 0.12mm && ((A.Layer == 'In1.Cu' && ((A.NetName == '/ESC1/PHASE_C' && A.enclosedByArea('ESC1_PHASE_C_SENSE')) || (A.NetName == '/ESC4/PHASE_A' && A.enclosedByArea('ESC4_PHASE_A_SENSE')))) || (A.Layer == 'In4.Cu' && ((A.NetName == '/ESC1/PHASE_A' && A.enclosedByArea('ESC1_PHASE_A_SENSE')) || (A.NetName == '/ESC1/PHASE_B' && A.enclosedByArea('ESC1_PHASE_B_SENSE'))))))) || A.NetClass == 'RF' || (A.NetClass == 'Analog' && !(A.Type == 'Track' && A.Width == 0.12mm && ((A.NetName == '/RP2350A/ADC_VBAT' && A.Layer == 'In1.Cu' && A.enclosedByArea('ADC_VBAT_IN1_LOCAL')) || (A.NetName == '/RP2350A/ADC_VBAT' && A.Layer == 'In4.Cu' && A.enclosedByArea('ADC_VBAT_IN4_LOCAL')) || (A.NetName == '/RP2350A/ADC_CURR' && A.Layer == 'In1.Cu' && A.enclosedByArea('ADC_CURR_IN1_LOCAL')) || (A.NetName == '/RP2350A/ADC_CURR' && A.Layer == 'In4.Cu' && A.enclosedByArea('ADC_CURR_IN4_LOCAL')) || (A.NetName == '/OSD/OSD_LVL' && A.Layer == 'In1.Cu' && A.enclosedByArea('OSD_LVL_LOCAL')) || (A.NetName == '/PA_DET' && ((A.Layer == 'In1.Cu' && A.enclosedByArea('PA_DET_IN1_LOCAL')) || (A.Layer == 'In4.Cu' && A.enclosedByArea('PA_DET_IN4_LOCAL'))))))))) && !(A.Type == 'Track' && A.NetName == '/VIDEO_IN' && A.Layer == 'In1.Cu' && A.Width == 0.15mm && A.enclosedByArea('VIDEO_IN_LOCAL_BRIDGE'))"))

# The RP core buck switch node and boost switch node stay inside their component-side hot loops.
(rule "Regulator switch nodes: outer layers only"
  (constraint disallow track zone)
  (condition "A.Layer != 'F.Cu' && A.Layer != 'B.Cu' && (A.NetName == '/RP2350A/VREG_LX' || A.NetName == '/POWER/U2_SW')"))

# Keep each RF chain on one outer face over its GND reference.
# The former cross-face PA-input exception is removed; the 1+4+1 via stack is not a verified RF launch.
(rule "RF: no vias"
  (constraint disallow via)
  (condition "A.NetClass == 'RF'"))

# Spec 8.2: CPWG, gap 0.15 mm (the RF clearance), L1 over L2 and L6 over L5, 50 ohm +- 10 %.
# Width 0.105 mm from the 2-D field solver with solder mask (setup_board.py, impedance.json):
# 49.58 ohm at Er 4.20, 50.9 ohm at Er 3.91
(rule "RF: 50 ohm width on the outer layers"
  (layer outer)
  (constraint track_width (min 0.100mm) (opt 0.105mm) (max 0.110mm))
  (condition "A.NetClass == 'RF'"))

# Spec 8.4 / 10: no non-GND via under the 2.4 GHz feed (L1, FL1 OUT to the hole), so L2 stays solid under it.
(rule "RF_RX_FEED: GND vias only"
  (constraint disallow via)
  (condition "A.intersectsArea('RF_RX_FEED') && A.NetName != 'GND'"))

# v4 K5 (replaces RF_VTX_CHAIN): no non-GND via inside the 0.5 mm strip around the 5.8 GHz chain, so L2 stays solid
# under the line. All RF signal nets stay via-free.
(rule "RF_VTX_STRIP: GND vias only (K5)"
  (constraint disallow via)
  (condition "A.intersectsArea('RF_VTX_STRIP') && A.NetName != 'GND'"))

# v4 K2 (replaces RF_RX_ANT / _L6 / RF_RX_EXIT): inside the D2.0 circle at the RX wire hole AE1 (all layers; pours
# kept out by the rule area) the only copper is the 2.4 GHz feed /RX/RF_RX_ANT on L1 into the AE1 pad; no vias.
(rule "RF_RX_HOLE: only the RF feed on L1 (K2)"
  (constraint disallow track via)
  (condition "A.intersectsArea('RF_RX_HOLE') && (A.Type == 'Via' || A.NetName != '/RX/RF_RX_ANT' || A.Layer != 'F.Cu')"))

# v4 K2: no other part's pad inside the D2.0 circle at the RX wire hole.
(rule "RF_RX_HOLE: no pad but AE1's (K2)"
  (constraint disallow pad)
  (condition "A.Type == 'Pad' && A.intersectsArea('RF_RX_HOLE') && !A.memberOfFootprint('AE1')"))

# Spec 4.9 / 11: the blackbox bus (75 MHz writes, 50 MHz reads) has harmonics in the ELRS band; SPI0 and
# the NOR chip select stay outside RF_RX_ROOT (r 3.0 around the hole) on every layer. Route sync 2026-10-10
# (P4 ruling 'add SPI0 to the 3 mm rule'): the schematic nets are /SPI0_MISO, /SPI0_MOSI, /SPI0_SCK.
(rule "SPI0 3 mm from the RX antenna hole"
  (constraint disallow track via)
  (condition "A.intersectsArea('RF_RX_ROOT') && (A.NetName == '*SPI0_*' || A.NetName == '*SPI0.*' || A.NetName == '*FLASH_CS*')"))

# D10 / spec 11: the battery-to-shunt corridor (on the shunt's layer, F.Cu in P2 v3) carries CSA+, +BATT and GND; the Kelvin pair
# SHUNT_SENSE_P/N leaves at the shunt's inner pad edges. Everything else stays out before routing.
(rule "SHUNT_CORRIDOR: battery current only"
  (layer "F.Cu")
  (constraint disallow track via)
  (condition "A.intersectsArea('SHUNT_CORRIDOR') && A.NetClass != 'VBAT' && A.NetName != 'GND' && A.NetName != '*SHUNT_SENSE_*'"))

# D72 / D76: the vertical USB plug and the fingers that push it need the space around J31 free of other
# connectors (TALL class J*: SH/SUR plugs, U.FL); parts <= 1.25 mm tall (2520 inductor, passives, ICs) sit far
# below the 4.25 mm BM04B wall the plug is gripped above, so they keep only the body rule.
(rule "USB_MATING: no tall part next to J31"
  (constraint courtyard_clearance (min 1.0mm))
  (condition "(A.Reference == 'J31' && B.hasComponentClass('TALL') && B.Reference == 'J*' && B.Reference != 'J31') || (B.Reference == 'J31' && A.hasComponentClass('TALL') && A.Reference == 'J*' && A.Reference != 'J31')"))

# Spec 8.2: USB FS pair 0.12 / 0.12. Inert until the nets end in _P/_N, P/N or +/- (KiCad 10.0.6 does
# not pair USB_DP/USB_DM): name them USB_D+ / USB_D- or USB_DP / USB_DN in P4.
(rule "USB: pair gap"
  (constraint diff_pair_gap (min 0.10mm) (opt 0.12mm) (max 0.20mm))
  (condition "A.NetClass == 'USB'"))

# Spec 8.2: length-matched pair; 0.5 mm is about 3 ps, far inside the 12 Mbit/s budget.
(rule "USB: length match"
  (constraint skew (max 0.5mm) (within_diff_pairs))
  (condition "A.NetClass == 'USB'"))

# D21 / route sync 2026-10-10: the Analog class clearance (0.15) also hits pad pairs inside the 1.0 x 0.8 X2SON
# video switch U14 (SN74LVC1G3157DTBR, land gap 0.10) and the 0.8 x 0.8 X2SON comparator U15 (TLV7031DPWR, 0.11).
# Those gaps are the manufacturer land pattern, above the 0.09 fab minimum; routed copper keeps the class clearance.
(rule "D21 Analog X2SON land gaps (U14, U15)"
  (constraint clearance (min 0.09mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && ((A.memberOfFootprint('lib:X2SON-6_L1.0-W0.8-BL_Dense') && B.memberOfFootprint('lib:X2SON-6_L1.0-W0.8-BL_Dense')) || (A.memberOfFootprint('lib:X2SON-4_L0.8-W0.8-P0.48-TL-A_Dense') && B.memberOfFootprint('lib:X2SON-4_L0.8-W0.8-P0.48-TL-A_Dense')))"))

(rule "RX hole: no other footprints"
  (severity warning)
  (constraint disallow footprint)
  (condition "A.Type == 'Footprint' && A.intersectsArea('RF_RX_HOLE') && A.Reference != 'AE1'"))

(rule "WiFi window: no vias"
  (constraint disallow via)
  (condition "A.intersectsArea('WIFI_FULL_WINDOW')"))

(rule "WiFi window: no other component pads"
  (constraint disallow pad)
  (condition "A.Type == 'Pad' && A.intersectsArea('WIFI_FULL_WINDOW') && !A.memberOfFootprint('AE2')"))

(rule "WiFi window: no other footprints"
  (severity warning)
  (constraint disallow footprint)
  (condition "A.Type == 'Footprint' && A.intersectsArea('WIFI_FULL_WINDOW') && A.Reference != 'AE2'"))

(rule "WiFi front: only feed and ground strip"
  (constraint disallow track)
  (condition "A.Layer == 'F.Cu' && A.intersectsArea('WIFI_FULL_WINDOW') && !(A.NetName == '/RX/RF_WIFI' || A.NetName == '/RX/RF_WIFI_ANT' || (A.NetName == 'GND' && !A.intersectsArea('WIFI_FRONT_VOID')))"))

(rule "WiFi front: only ground zone in terminal strip"
  (constraint disallow zone)
  (condition "A.Layer == 'F.Cu' && A.intersectsArea('WIFI_FULL_WINDOW') && A.NetName != 'GND'"))

(rule "VTX adjacent reference: ground zones only"
  (constraint disallow zone)
  (condition "A.Layer == 'In4.Cu' && A.intersectsArea('VTX_IN4_REFERENCE') && A.NetName != 'GND'"))

# v4 / spec 7: grommet flange D5.2 bars part bodies; edge solder pads may enter (their copper stays out of D4.6,
# rule areas MOUNT_PAD_*). Motor headers (MOTOR_PAD) are not exempt: their DNP PicoBlade body is a part.
(rule "v4 MOUNT flange: no part bodies"
  (constraint disallow footprint)
  (condition "A.Type == 'Footprint' && (A.intersectsArea('MOUNT_LEFT') || A.intersectsArea('MOUNT_REAR') || A.intersectsArea('MOUNT_RIGHT')) && !(A.hasComponentClass('SOLDER_PAD') && !A.hasComponentClass('MOTOR_PAD'))"))

# D90 (replaces WIFI_ANT_KO): net-aware antenna void on B / In4 / In3. Only the RF feed nets; no via. D21 scoped
# exception: the AE2 pins 2/3 GND link on B.Cu inside WIFI_GND_LINK (<= 0.3 mm to the void edge, GND vias just
# outside V1; ANTENNA-WIFI.md 9, Johanson test-board orientation).
(rule "D90 wifi_antenna_void: only the feed"
  (constraint disallow track via)
  (condition "A.intersectsArea('WIFI_VOID_V1') && (A.Type == 'Via' || (A.NetName != '/RX/RF_WIFI' && A.NetName != '/RX/RF_WIFI_ANT' && !(A.NetName == 'GND' && A.Layer == 'B.Cu' && A.enclosedByArea('WIFI_GND_LINK'))))"))

# D90: no other part's pad inside the antenna void.
(rule "D90 wifi_antenna_void: only AE2 and its pi parts"
  (constraint disallow pad)
  (condition "A.Type == 'Pad' && A.intersectsArea('WIFI_VOID_V1') && !(A.memberOfFootprint('AE2') || A.memberOfFootprint('C132') || A.memberOfFootprint('C133') || A.memberOfFootprint('R88'))"))

# D90 / ANTENNA-WIFI.md 6.4: parts allowed on F over the antenna; small signal / passive pads are fine, but no
# exposed pad or large GND land (>= 0.8 x 0.8 mm) in the body projection (WIFI_FAR_F).
(rule "D90 wifi far side: no exposed GND pad over the antenna body"
  (constraint disallow pad)
  (condition "A.Type == 'Pad' && A.intersectsArea('WIFI_FAR_F') && A.NetName == 'GND' && A.Pad_Type == 'SMD' && A.Size_X >= 0.8mm && A.Size_Y >= 0.8mm"))

# D92: In4 GND unbroken under the boost site: only GND and the boost's own supply vias.
(rule "D92 boost ground under the hot loop"
  (constraint disallow via)
  (condition "A.Type == 'Via' && A.intersectsArea('BOOST_GND_L5') && A.NetName != 'GND' && A.NetName != '+BATT' && A.NetName != '+5V_BST'"))
